{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/infrastructure/v1/project_class.schema.json",
  "title": "Project class catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "projectClasses"],
  "properties": {
    "apiVersion": {"const": "infrastructure.mindclade.dev/v1"},
    "kind": {"const": "ProjectClassCatalog"},
    "projectClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "folderBindingRequired", "billingBindingRequired", "deletionProtection", "sharedVpcServiceProject", "allowedEnvironmentTiers"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
          "folderBindingRequired": {"const": true},
          "billingBindingRequired": {"const": true},
          "deletionProtection": {"const": true},
          "sharedVpcServiceProject": {"const": true},
          "allowedEnvironmentTiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["development", "staging", "production", "restricted"]}}
        }
      }
    }
  }
}
