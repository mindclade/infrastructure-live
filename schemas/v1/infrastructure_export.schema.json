{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/infrastructure/v1/infrastructure_export.schema.json",
  "title": "Immutable infrastructure export",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "infrastructure.mindclade.dev/v1"},
    "kind": {"const": "InfrastructureExport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "stack", "sourceRepository", "sourceCommit", "root", "planDigest", "providerLockDigest", "backendStateDigest", "backendLineage", "backendSerial", "schemaDigest", "generatedAt"],
      "properties": {
        "environment": {"enum": ["development", "staging", "production", "restricted"]},
        "stack": {"enum": ["foundation", "network", "artifacts", "data-services", "clusters", "ci-execution", "observability"]},
        "sourceRepository": {"const": "mindclade/infrastructure-live"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "root": {"type": "string", "pattern": "^opentofu/live/(development|staging|production|restricted)/(foundation|network|artifacts|data-services|clusters|ci-execution|observability)$"},
        "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "providerLockDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "backendStateDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "backendLineage": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "backendSerial": {"type": "integer", "minimum": 0},
        "schemaDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "evidence"],
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "uri"],
            "properties": {
              "kind": {"enum": ["project", "network", "subnetwork", "private-dns-zone", "artifact-registry", "artifact-bucket", "database-instance", "topic", "kms-key-reference", "cluster-membership", "workload-identity-pool", "build-execution-pool", "log-bucket", "metrics-scope", "argocd-prerequisite"]},
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,126}$"},
              "uri": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^(https:)?//[^/?#@\\s]+/[^?#\\s]+$"
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signature", "provenance"],
          "properties": {
            "signature": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "keyId", "publicKey", "value", "payloadDigest"],
              "properties": {
                "algorithm": {"const": "Ed25519"},
                "keyId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
                "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
                "payloadDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            },
            "provenance": {"$ref": "#/$defs/evidenceReference"}
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@\\s]+/[^?#\\s]+$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
