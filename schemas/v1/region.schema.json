{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/infrastructure/v1/region.schema.json",
  "title": "Region catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "regions"],
  "properties": {
    "apiVersion": {"const": "infrastructure.mindclade.dev/v1"},
    "kind": {"const": "RegionCatalog"},
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "enabled", "primaryLocation", "recoveryLocation", "residency", "regionalControlPlanes", "privateGoogleAccessRequired"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
          "enabled": {"type": "boolean"},
          "primaryLocation": {"type": ["string", "null"], "pattern": "^[a-z]+-[a-z]+[0-9]$"},
          "recoveryLocation": {"type": ["string", "null"], "pattern": "^[a-z]+-[a-z]+[0-9]$"},
          "residency": {"enum": ["us"]},
          "regionalControlPlanes": {"const": true},
          "privateGoogleAccessRequired": {"const": true}
        },
        "allOf": [
          {
            "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
            "then": {"properties": {"primaryLocation": {"type": "string"}}},
            "else": {"properties": {"primaryLocation": {"type": "null"}, "recoveryLocation": {"type": "null"}}}
          }
        ]
      }
    }
  }
}
