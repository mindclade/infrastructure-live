{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/infrastructure/v1/environment.schema.json",
  "title": "Environment catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "environments"],
  "properties": {
    "apiVersion": { "const": "infrastructure.mindclade.dev/v1" },
    "kind": { "const": "EnvironmentCatalog" },
    "environments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled",
          "sourceReady",
          "activationEnabled",
          "authorityOrder",
          "sourceReadyCapabilities",
          "dataServicesEnabled",
          "productionLike",
          "regionProfile",
          "projectClass",
          "dataClasses",
          "resourceProfile",
          "acceleratorProfiles",
          "approvalMode",
          "gitopsPromotionMode"
        ],
        "properties": {
          "name": { "enum": ["development", "staging", "production", "restricted"] },
          "enabled": { "type": "boolean" },
          "sourceReady": { "type": "boolean" },
          "activationEnabled": { "type": "boolean" },
          "authorityOrder": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "foundation",
                "network",
                "artifacts",
                "clusters",
                "observability",
                "ci-execution"
              ]
            }
          },
          "sourceReadyCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "foundation",
                "network",
                "artifact-registry",
                "gcs",
                "cloud-kms",
                "regional-private-gke",
                "observability",
                "ci",
                "argocd-inputs",
                "nix-cache",
                "estate-ci-edge"
              ]
            }
          },
          "dataServicesEnabled": { "const": false },
          "productionLike": { "type": "boolean" },
          "regionProfile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
          "projectClass": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
          "dataClasses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["public", "internal", "confidential", "restricted"] }
          },
          "resourceProfile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
          "acceleratorProfiles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" }
          },
          "approvalMode": {
            "enum": ["pull-request", "protected-environment", "protected-environment-two-person"]
          },
          "gitopsPromotionMode": { "enum": ["automatic-after-evidence", "manual"] }
        },
        "allOf": [
          {
            "if": {
              "properties": { "sourceReady": { "const": true } },
              "required": ["sourceReady"]
            },
            "then": {
              "properties": {
                "name": { "const": "development" },
                "authorityOrder": {
                  "prefixItems": [
                    { "const": "foundation" },
                    { "const": "network" },
                    { "const": "artifacts" },
                    { "const": "clusters" },
                    { "const": "observability" },
                    { "const": "ci-execution" }
                  ],
                  "items": false,
                  "minItems": 6,
                  "maxItems": 6
                },
                "sourceReadyCapabilities": {
                  "prefixItems": [
                    { "const": "foundation" },
                    { "const": "network" },
                    { "const": "artifact-registry" },
                    { "const": "gcs" },
                    { "const": "cloud-kms" },
                    { "const": "regional-private-gke" },
                    { "const": "observability" },
                    { "const": "ci" },
                    { "const": "argocd-inputs" },
                    { "const": "nix-cache" },
                    { "const": "estate-ci-edge" }
                  ],
                  "items": false,
                  "minItems": 11,
                  "maxItems": 11
                }
              }
            },
            "else": {
              "properties": {
                "activationEnabled": { "const": false },
                "authorityOrder": { "maxItems": 0 },
                "sourceReadyCapabilities": { "maxItems": 0 }
              }
            }
          }
        ]
      }
    }
  }
}
