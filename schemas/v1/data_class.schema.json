{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.dev/infrastructure/v1/data_class.schema.json",
  "title": "Data class catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "dataClasses"],
  "properties": {
    "apiVersion": {"const": "infrastructure.mindclade.dev/v1"},
    "kind": {"const": "DataClassCatalog"},
    "dataClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "publicAccessPermitted", "customerManagedEncryptionRequired", "auditDataAccessRequired", "minimumRetentionDays"],
        "properties": {
          "name": {"enum": ["public", "internal", "confidential", "restricted"]},
          "publicAccessPermitted": {"type": "boolean"},
          "customerManagedEncryptionRequired": {"type": "boolean"},
          "auditDataAccessRequired": {"type": "boolean"},
          "minimumRetentionDays": {"type": "integer", "minimum": 0, "maximum": 3650}
        }
      }
    }
  }
}
