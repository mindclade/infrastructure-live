load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "repository_source",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".editorconfig",
        ".gitignore",
        ".golangci.yml",
        ".markdownlint-cli2.yaml",
        ".pre-commit-config.yaml",
        ".vscode/extensions.json",
        ".vscode/settings.json",
        ".yamllint.yaml",
        "CONTRIBUTING.md",
        "MODULE.bazel.lock",
        "LICENSE",
        "biome.json",
        "flake.lock",
        "flake.nix",
        "justfile",
        "pyproject.toml",
    ] + glob([
        ".github/**",
        "catalog/**",
        "opentofu/**",
        "policy/**",
        "runbooks/**",
        "schemas/**",
        "tests/**",
        "*.md",
        "*.yaml",
        "*.bazel",
    ]),
)

